<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin require-restart="false">
    <id>io.github.notstirred.dasm.plugin</id>
    <name>DASM Dev</name>
    <description>Auto-completion and inspections for DASM</description>
    <vendor>NotStirred</vendor>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.demonwav.minecraft-dev</depends>

    <extensions defaultExtensionNs="com.intellij">
        <psi.referenceContributor language="JAVA"
                                  implementation="io.github.notstirred.dasm.plugin.reference.DasmReferenceContributor"/>
        <localInspection displayName="Unresolved reference"
                         shortName="UnresolvedDasmReference"
                         groupName="Dasm"
                         language="JAVA"
                         enabledByDefault="true"
                         level="ERROR"
                         hasStaticDescription="true"
                         implementationClass="io.github.notstirred.dasm.plugin.inspection.UnresolvedReferenceInspection"/>
        <localInspection displayName="Deprecated Dasm Sig"
                         shortName="DeprecatedDasmSig"
                         groupName="Dasm"
                         language="JAVA"
                         enabledByDefault="true"
                         level="ERROR"
                         hasStaticDescription="true"
                         implementationClass="io.github.notstirred.dasm.plugin.inspection.DeprecatedDasmSigInspection"/>
    </extensions>
</idea-plugin>
